# API metadata
API_TITLE=ResearchGen API
API_VERSION=0.1.0

# CORS: comma-separated values
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:80

# LLM providers
OLLAMA_BASE_URL=https://ollama.com/api
OLLAMA_MODEL=qwen3.5:397b-cloud
OLLAMA_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Runtime model tiers (optional — small=fast cues/classification, large=drafting/review)
# OLLAMA_SMALL_MODEL=
# GROQ_SMALL_MODEL=llama-3.1-8b-instant
# GROQ_LARGE_MODEL=llama-3.3-70b-versatile
# GEMINI_SMALL_MODEL=gemini-2.0-flash-exp
# GEMINI_LARGE_MODEL=gemini-2.0-flash-exp

# Retrieval providers
OPENALEX_API_KEY=
OPENALEX_EMAIL=
# CrossRef polite-pool contact (defaults to OPENALEX_EMAIL if unset)
CROSSREF_MAILTO=
# Semantic dedup/relevance embedding model (set to disable by leaving sentence-transformers out)
# SEARCH_EMBED_MODEL=all-MiniLM-L6-v2
